{
  "name": "@repo/bench",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bench": "PLAYWRIGHT_BROWSERS_PATH=$PWD/.browsers node --env-file-if-exists=../../.env src/run.ts",
    "serve": "node src/serve.ts",
    "browsers": "PLAYWRIGHT_BROWSERS_PATH=$PWD/.browsers playwright install --only-shell chromium"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "playwright": "catalog:"
  }
}
