{
  "name": "@repo/eval",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./businesses": "./src/businesses.ts",
    "./stand-in": "./src/stand-in.ts",
    "./site-content": "./src/site-content.ts",
    "./briefs": "./src/briefs.ts",
    "./photos/manifest.json": "./photos/manifest.json",
    "./photos": "./src/photos.ts",
    "./grammar/choose": "./src/grammar/choose.ts",
    "./grammar/page": "./src/grammar/page.ts",
    "./grammar/rule-profiles.json": "./src/grammar/rule-profiles.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "eval": "node src/index.ts",
    "samples": "vitest run --config vitest.tasks.config.ts samples",
    "block-log": "node src/block-log.ts",
    "styles": "vitest run --config vitest.tasks.config.ts styles",
    "sheet": "vitest run --config vitest.tasks.config.ts sheet",
    "photos": "node --env-file-if-exists=../../.env src/photos.ts",
    "advance": "vitest run --config vitest.tasks.config.ts advance",
    "wall": "vitest run --config vitest.tasks.config.ts wall",
    "m0": "vitest run --config vitest.tasks.config.ts m0",
    "board": "vitest run --config vitest.tasks.config.ts board",
    "directions": "vitest run --config vitest.tasks.config.ts directions",
    "directions-wall": "vitest run --config vitest.tasks.config.ts directions-wall",
    "photo-tones": "vitest run --config vitest.tasks.config.ts photo-tones",
    "grammar": "vitest run --config vitest.tasks.config.ts grammar",
    "references": "vitest run --config vitest.tasks.config.ts references"
  },
  "dependencies": {
    "@repo/blocks": "workspace:*",
    "@repo/pipeline": "workspace:*",
    "@repo/render": "workspace:*",
    "@repo/spec": "workspace:*",
    "culori": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@pogrobert/surfaces": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/culori": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
