{
  "name": "@repo/blocks",
  "private": true,
  "type": "module",
  "exports": {
    "./manifest": "./src/manifest/index.ts",
    "./components": "./src/components/index.ts",
    "./kit.css": "./src/kit/kit.css",
    "./draft-theme.css": "./src/kit/draft-theme.css",
    "./build": "./src/build.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "registry": "node scripts/registry.ts && biome format --write src/manifest/index.ts src/components/index.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@repo/spec": "workspace:*",
    "react": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@pogrobert/surfaces": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "playwright": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:"
  }
}
