{
  "name": "builder-root",
  "private": true,
  "license": "MIT-0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "check": "biome ci . && pnpm -r --parallel typecheck && pnpm -r test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @repo/web dev",
    "build": "pnpm --filter @repo/web build",
    "eval": "pnpm --filter @repo/eval eval"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
