# Copy to .env (gitignored). The tools in tools/eval and tools/bench read it, and the web app
# reads it through apps/web/.dev.vars, a link to this file (ln -s ../../.env apps/web/.dev.vars).
# The keys and what each is for: apps/web/.dev.vars.example. Never commit real keys.
TYPESAFE_API_KEY=
OPENROUTER_API_KEY=
PIXABAY_API_KEY=
TMDB_TOKEN=
RAWG_API_KEY=
