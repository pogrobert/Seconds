# The keys the app reads. Copy to the root .env (gitignored) and link this folder's .dev.vars
# to it (ln -s ../../.env apps/web/.dev.vars), so the app and the tools share one file. Never
# commit real keys.
# Decision model (Jev) through TypeSafe: https://typesafe.ai
TYPESAFE_API_KEY=
# Text model through OpenRouter: https://openrouter.ai
OPENROUTER_API_KEY=
# Stock photos through Pixabay (free account): https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Optional. Film and TV stills for famous subjects (TMDB, free for non-commercial use, API Read
# Access Token): https://www.themoviedb.org/settings/api
TMDB_TOKEN=
# Optional. Game screenshots for famous subjects (IGDB, through a Twitch app):
# https://dev.twitch.tv/console
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional. Game screenshots without Twitch (RAWG, free for non-commercial use, email sign-up):
# https://rawg.io/apidocs
RAWG_API_KEY=

# Turns on the bench-only routes (/api/build, /api/template, /api/template-pick) for tools/bench.
# Never set in production.
# BENCH=1
